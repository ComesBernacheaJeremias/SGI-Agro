# Producción: copiar a deploy/.env (cp .env.prod.example .env) y completar. NUNCA subir el .env.

# --- Dominio (sin dominio todavía: ":80", solo para probar por IP) ---
DOMAIN=gestion.empresa.com.ar

# --- Base de datos ---
# Administrador de PostgreSQL: solo para crear la base y hacer backups/restauraciones
DB_ADMIN_USER=sgi_admin
# Contraseñas largas y aleatorias: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_ADMIN_PASSWORD=
# Usuario de la aplicación (sin superusuario, dueño solo de su base)
POSTGRES_USER=sgi_app
POSTGRES_PASSWORD=
POSTGRES_DB=sgi_agro

# --- Autenticación ---
# Clave larga y aleatoria: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Errores (opcional): DSN del proyecto en sentry.io; vacío = desactivado ---
SENTRY_DSN=
# La completa deploy.sh con la versión del repositorio
APP_VERSION=

# --- Backups a DigitalOcean Spaces (opcional pero MUY recomendado) ---
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=nyc3
# Hora del backup diario (00-23)
BACKUP_HOUR=03
