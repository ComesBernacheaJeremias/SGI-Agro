# Copiar a .env (cp .env.example .env) y ajustar valores. El .env NUNCA se sube al repositorio.

# --- Entorno ---
ENVIRONMENT=development

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=sgi
POSTGRES_PASSWORD=sgi_dev_password
POSTGRES_DB=sgi_agro
# Host de la base visto desde la API (dentro de Docker es el servicio "db")
DB_HOST=db
DB_PORT=5432
# Puerto expuesto en tu PC (5433 para no chocar con un PostgreSQL local)
DB_HOST_PORT=5433

# --- Autenticación ---
# Clave para firmar los tokens. En producción: una cadena aleatoria larga (ej. `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Puertos en tu PC ---
API_HOST_PORT=8000
WEB_HOST_PORT=5173
